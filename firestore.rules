rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function signedIn() {
      return request.auth != null;
    }

    function event(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId));
    }

    function isOwner(eventId) {
      return signedIn() && event(eventId).data.ownerId == request.auth.uid;
    }

    function isMember(eventId) {
      return signedIn() && exists(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid));
    }

    function getMemberRole(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid)).data.role;
    }

    function isEditor(eventId) {
      return isMember(eventId) && getMemberRole(eventId) == "editor";
    }

    function isViewer(eventId) {
      return isMember(eventId) && getMemberRole(eventId) == "viewer";
    }

    function canEdit(eventId) {
      return isOwner(eventId) || isEditor(eventId);
    }

    function canViewPrivate(eventId) {
      return isOwner(eventId) || isMember(eventId);
    }

    // --- User Profiles ---
    // Each user can read, create, update, or delete only their own profile
    match /users/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    // --- Event Websites ---
    match /events/{eventId} {
      // Owner creates their own event; cannot assign someone else as ownerId
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;

      // Public visitors can only view published events (visibility == "public");
      // Private events are only viewable by owner or invited members (editors & viewers).
      allow read: if resource.data.visibility == "public" || canViewPrivate(eventId);

      // Editors can update content, but CANNOT alter ownerId or toggle visibility. Only owners can toggle visibility or manage event settings.
      allow update: if canEdit(eventId) 
        && request.resource.data.ownerId == resource.data.ownerId
        && (isOwner(eventId) || request.resource.data.visibility == resource.data.visibility);

      // Only the primary owner can delete the event
      allow delete: if isOwner(eventId);

      // --- Members Subcollection (Granular RBAC) ---
      // Only the primary owner can invite, promote, demote, or remove members
      match /members/{uid} {
        allow read: if isOwner(eventId) || (signedIn() && request.auth.uid == uid);
        allow create, update, delete: if isOwner(eventId);
      }

      // --- RSVP Subcollection ---
      // Submissions are strictly channeled through verified backend API / Cloud Functions (sanitized, rate-limited, anti-spam)
      // Direct client writes are forbidden.
      // Editors and owners can read RSVP summaries; updates and deletes are owner-only.
      match /rsvps/{rsvpId} {
        allow read: if canEdit(eventId);
        allow update, delete: if isOwner(eventId);
        allow create: if false;
      }

      // --- Private Settings & Sensitive Attendee Data Subcollection ---
      // Full phone numbers, dietary allergies, meal choices, vendor contracts: strictly owner-only.
      match /private/{docId} {
        allow read, write: if isOwner(eventId);
      }

      // --- Digital Guestbook Subcollection ---
      // Direct client writes are forbidden; guestbook messages are processed and moderated via backend API.
      match /guestbook/{messageId} {
        allow read: if resource.data.visibility == "public" || canViewPrivate(eventId);
        allow update, delete: if canEdit(eventId);
        allow create: if false;
      }
    }
  }
}
